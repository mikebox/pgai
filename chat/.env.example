# Copy to chat/.env
GEMINI_API_KEY=...            # from https://aistudio.google.com/apikey

# CHAT_LLM_MODEL=gemini-4-argon   # or gemini-4-carbon (strongest, slower) / gemini-4-hydrogen (fastest)
# CHAT_LLM_THINKING=low           # minimal | low | medium | high

# Most-secure mode (picked on the landing page): local Gemma 4 via Ollama, no cloud calls, no tracing
# OLLAMA_HOST=http://localhost:11434
# CHAT_SECURE_LLM_MODEL=gemma4:e4b
# CHAT_SECURE_LLM_TIMEOUT_S=120

# LOAN_MODEL=auto          # default: trained model (models/loan_decision_model.joblib), placeholder if missing
# LOAN_MODEL=trained       # trained model, error if missing
# LOAN_MODEL=placeholder   # stub, for UI work
# DECISION_THRESHOLD=0.09  # only to override the trained model's own threshold (P(DECLINED) >= t -> DECLINED)

# CHAT_AUDIT_LOG=logs/chat_audit.jsonl

# LangSmith tracing (optional). Free key at https://smith.langchain.com -> Settings -> API Keys
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=abc-credit-loan-chatbot
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for an EU-region account
